include "common.fbs";

namespace Ikkaku.gfx2;

enum LightCurveInterpolation:uint { Constant, Linear, TangentAuto, TangentBreak, TangentUser }

table LightCurveKey {
    time:float;
    value:float;
    tangent_left:float;
    tangent_right:float;
    interpolation:LightCurveInterpolation;
}
table LightCurve { keys:[LightCurveKey]; }
table LightCurve4 { x:LightCurve; y:LightCurve; z:LightCurve; w:LightCurve; }
table LightTransformCurve { scale:LightCurve4; rotation:LightCurve4; translation:LightCurve4; }

table BoundMatrix 
{
    x: Ikkaku.Math.Vec3; // scale
    y: Ikkaku.Math.Vec3; // Euler rotation, radians
    z: Ikkaku.Math.Vec3; // translation
}

table Vec4Parameter 
{
    param_name: string;
    value: Ikkaku.Math.Vec4;
    curve: LightCurve4;
}

table FloatParameter 
{
    param_name: string;
    param_val: float;
    curve: LightCurve;
}

table StringParameter 
{
    map_name: string;
    map_file: string;
}

table Light 
{
    name: string;
    type: string;
    matrix: BoundMatrix;
    float_params: [FloatParameter];
    vec4_params: [Vec4Parameter];
    string_params: [StringParameter];
    transform_curve: LightTransformCurve;
}

table TRLGT
{
    version: uint32;
    lights: [Light];
}

root_type TRLGT;