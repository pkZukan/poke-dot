include "../common.fbs";

namespace Ikkaku.TrinityScene;

union PlacementItem
{
    PlacementPositions,
    PlacementObjects,
    PlacementObjectTemplates,
    PlacementSpawners,
}

table PlacementPosition
{
    id: string;
    pos: Ikkaku.Math.Vec3;
    rot: Ikkaku.Math.Vec3;
}

table PlacementPositions
{
    positions: [PlacementPosition];
}

table PlacementObjects
{
    
}

table PlacementObjectTemplates
{
    
}

table PlacementSpawners
{
    
}

table TrinityPlacementRegistry
{
    item: PlacementItem;
}

root_type TrinityPlacementRegistry;
