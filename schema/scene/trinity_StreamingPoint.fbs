include "../common.fbs";

namespace Ikkaku.TrinityScene;

table TrinityStreamingObject
{
    name: string;
    nested_type: [uint8];
}

table TrinityStreamingPointData
{
    name: string;
    position: Ikkaku.Math.Vec3;
}

table TrinityStreamingEntry
{
    point: TrinityStreamingPointData;
    objects: [TrinityStreamingObject];
}

table TrinityStreamingPoint
{
    entries: [TrinityStreamingEntry];
}

root_type TrinityStreamingPoint;
