include "../common.fbs";

namespace Ikkaku.TrinityScene;

table TrinityCameraEntity
{
    name: string;
    activate: bool;
    position: Ikkaku.Math.Vec3;
    rotation: Ikkaku.Math.Vec3;
    distance: float;
    fov_y: float;
    near_plane: float;
    far_plane: float;
    projection_type: uint8;
    camera_mode: uint8;
    target_name: string;
    use_roll: bool;
    roll: float;
    attach_transform: bool;
}

root_type TrinityCameraEntity;
