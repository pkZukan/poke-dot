include "../common.fbs";

namespace Titan.TrinityScene;

// Explicit on-disk tags; declaration order must not renumber asset payloads.
union PropVal
{
    PropInt = 1,
    PropDec = 2,
    PropStr = 3,
    Titan.Math.Vec2 = 4,
    Titan.Math.Vec3 = 5,
    Titan.Math.Vec4 = 6,
    PropEnum = 7,
    PropList = 8,
    PropTable = 9,
    PropUnion = 10,
}

table PropInt
{
    data: ulong;
    size: ubyte;
}

table PropDec
{
    data: double;
    size: ubyte;
}

table PropStr
{
    data: string;
}

table PropEnum
{
    name: string;
    val: int;
}

table PropUnion
{
    type: PropEnum;
    val: PropTable;
}

table PropField
{
    name: string;
    value: PropVal;
}

table PropTable
{
    fields: [PropField];
}

table PropList
{
    vals: [PropVal];
}

table TrinityPropertySheet
{
    property_name: string;
    property_template: string;
    unk0: [PropTable];
}

root_type TrinityPropertySheet;
