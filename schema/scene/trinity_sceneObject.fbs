include "../common.fbs";

namespace Ikkaku.TrinityScene;

table ObjectLayer
{
    priority: int;
    name: string;
    srt: Ikkaku.Math.Transform;
}

table TrinitySceneObject
{
    name: string;
    srt: Ikkaku.Math.SRT;
    keep_world_srt: bool;
	attach_xform: bool;
	attach_joint: string;
    scriptable: bool;
    priority: byte;
    layers: [ObjectLayer];
    tag_list: [string];
}

root_type TrinitySceneObject;
