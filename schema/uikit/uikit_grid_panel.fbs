include "../common.fbs";

namespace Titan.pe.UIKit;

table ButtonInfoTable {
    name: string;
    pos: Titan.Math.Vec2i;
    size: Titan.Math.Vec2i;
}

table UIKitGridPanel {
    name: string;
    cursor_name: string;
    grid_size: Titan.Math.Vec2i;
    mode: int;
    button_info: [ButtonInfoTable];
}

root_type UIKitGridPanel;
