include "../common.fbs";

namespace Ikkaku.pe.UIKit;

table ButtonInfoTable {
    name: string;
    pos: Ikkaku.Math.Vec2i;
    size: Ikkaku.Math.Vec2i;
}

table UIKitGridPanel {
    name: string;
    cursor_name: string;
    grid_size: Ikkaku.Math.Vec2i;
    mode: int;
    button_info: [ButtonInfoTable];
}

root_type UIKitGridPanel;
