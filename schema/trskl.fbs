include "common.fbs";

namespace Titan.Model;

file_extension "trskl";

enum NodeType: uint32 {
    Normal = 0,
    Chained = 1, 
    Leaf = 2
}

table SRT {
    VecScale: Titan.Math.Vec3;
    VecRot: Titan.Math.Vec3;
    VecTranslate: Titan.Math.Vec3;
}

table TransformNode {
    name: string;
    transform: SRT;
    scalePivot: Titan.Math.Vec3;
    rotatePivot: Titan.Math.Vec3;
    parent_idx: int32 = -1;
    rig_idx: int32 = -1;
    parent_name: string;
    type: NodeType;
}

table IKControl{
    ik_name: string;
    ik_chain_start: string;
    ik_chain_end: string;
    ik_type: string;
    res_4: uint32; //Always 0
    ik_pos: Titan.Math.Vec3;
    ik_rot: Titan.Math.Vec4;
}

table BoneMatrix{
    x: Titan.Math.Vec3;
    y: Titan.Math.Vec3;
    z: Titan.Math.Vec3;
    w: Titan.Math.Vec3;
}

table Bone {
    inherit_position: bool; //Value (0,1) Probably SegmentScaleCompensate?
    influence_skinning: bool = 0;
    matrix: BoneMatrix;
}

table TRSKL {
    res_0: uint32;
    transform_nodes: [TransformNode];
    bones: [Bone];
    iks: [IKControl];
    rig_offset: uint32;
}

root_type TRSKL;