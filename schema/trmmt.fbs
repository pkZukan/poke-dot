include "common.fbs";

namespace Ikkaku.Model;

file_extension "trmmt";

table RuleCopy
{
    source: string;
}

table RuleCopyIfPresent
{
    probe: string;
    source: string;
}

table RuleCase
{
    match: int;
    result: int;
}

table RuleSwitch
{
    source: string;
    cases: [RuleCase];
}

union RuleCondition
{
    RuleCopy,
    RuleCopyIfPresent,
    RuleSwitch,
}

table ControlRule
{
    name: string;
    upper: int;
    initial: int;
    condition: RuleCondition;
}

table FloatSeries
{
    name: string;
    values: [float];
}

table Vec3Series
{
    name: string;
    values: [Ikkaku.Math.Vec3];
}

table Vec4Series
{
    name: string;
    values: [Ikkaku.Math.Vec4];
}

table IntSeries
{
    name: string;
    values: [int];
}

table BoolSeries
{
    name: string;
    values: [bool];
}

table MaterialSeries
{
    material: string;
    floats: [FloatSeries];
    vec3s: [Vec3Series];
    vec4s: [Vec4Series];
    ints: [IntSeries];
}

table VariationTable
{
    count: int;
    materials: [MaterialSeries];
    mesh_visibility: [BoolSeries];
}

table CurveTarget
{
    mesh: string;
    material: string;
    attribute: string;
}

table MeshTarget
{
    mesh: string;
}

table DeformerTarget
{
    deformer: string;
}

table EmbeddedTRACM
{
    bytebuffer: [uint8] (force_align: 4);
}

table VariationControl
{
    name: string;
    curve_targets: [CurveTarget];
    frame_min: int;
    frame_max: int;
    tracm: EmbeddedTRACM;
    mesh_targets: [MeshTarget];
    deformer_targets: [DeformerTarget];
    rule: ControlRule;
    default_override: int = -1;
    table_driven: bool;
    variations: VariationTable;
}

table MeshToggle
{
    mesh: string;
    visible: bool;
}

table ModelVariation
{
    name: string;
    materials: [string];
    mesh_visibility: [MeshToggle];
    controls: [VariationControl];
    tracm_path: string;
}

table TRMMT
{
    version: uint32 = 2;
    model_path: string;
    variations: [ModelVariation];
    rule_path: string;
}

root_type TRMMT;
