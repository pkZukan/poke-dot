include "Ikkaku/Math/common.fbs";

namespace Ikkaku.Model;

file_extension "trmdl";


table trmeshes 
{
    filename: string;
}

table trskeleton 
{
    filename: string;
}

table LodIndex 
{
    unk0: uint32 = 0;
}

table Lod 
{
    index: [LodIndex];
    lod_type: string;
}

table Bounds 
{
    min: Ikkaku.Math.Vec3;
    max: Ikkaku.Math.Vec3;
}

table TRMDL 
{
    unk0:uint32;
    meshes:[trmeshes];
    skeleton:trskeleton;
    materials:[string];
    lods:[Lod];
    bounds: Bounds;
    tex_spc_loc: Ikkaku.Math.Vec4;
    trltt: string;
    unk8: uint32;
    unk9: uint32;
}

root_type TRMDL;
