include "Ikkaku/Math/common.fbs";

namespace Ikkaku.Model;

file_extension "trskl";

enum NodeType: uint32 {
    Normal = 0,
    Chained = 1, 
    Leaf = 2
}

table TransformNode {
    name: string;
    transform: Ikkaku.Math.SRT;
    scalePivot: Ikkaku.Math.Vec3;
    rotatePivot: Ikkaku.Math.Vec3;
    parent_idx: int32 = -1;
    rig_idx: int32 = -1;
    parent_name: string;
    type: NodeType;
    unk_0: bool;
    ignore_parent_rot: bool;
}

table IKControl{
    ik_name: string;
    ik_chain_start: string;
    ik_chain_end: string;
    ik_type: string;
    res_4: uint32; //Always 0
    ik_pos: Ikkaku.Math.Vec3;
    ik_rot: Ikkaku.Math.Vec4;
}

table BoneMatrix{
    x: Ikkaku.Math.Vec3;
    y: Ikkaku.Math.Vec3;
    z: Ikkaku.Math.Vec3;
    w: Ikkaku.Math.Vec3;
}

table Bone {
    inherit_position: bool; //Value (0,1) Probably SegmentScaleCompensate?
    influence_skinning: bool = 0;
    matrix: BoneMatrix;
}

table TRSKL {
    version: uint32;
    transform_nodes: [TransformNode];
    bones: [Bone];
    iks: [IKControl];
    rig_offset: uint32;
}

root_type TRSKL;