include "common.fbs";
include "anim_common.fbs";

namespace Ikkaku.Animation;

union VectorTrack { FixedVectorTrack, DynamicVectorTrack,  Framed16VectorTrack, Framed8VectorTrack }

table FixedVectorTrack 
{
    co: Ikkaku.Math.Vec3;
}

table DynamicVectorTrack 
{
    co: [Ikkaku.Math.Vec3];
}

table Framed16VectorTrack 
{
    frames:[uint16];
    co: [Ikkaku.Math.Vec3];
}

table Framed8VectorTrack 
{
    frames:[uint8];
    co:[Ikkaku.Math.Vec3];
}

union RotationTrack { FixedRotationTrack, DynamicRotationTrack, Framed16RotationTrack, Framed8RotationTrack }

table FixedRotationTrack 
{
    co: Ikkaku.Math.sVec3;
}

table DynamicRotationTrack 
{
    co:[Ikkaku.Math.sVec3];
}

table Framed16RotationTrack 
{
    frames:[uint16];
    co:[Ikkaku.Math.sVec3];
}

table Framed8RotationTrack 
{

    frames: [uint8];
    co: [Ikkaku.Math.sVec3];
}

table BoneTrack 
{
    bone_name: string;
    scale: VectorTrack;
    rotate: RotationTrack;
    translate: VectorTrack;
}

table BoneInit 
{
    isInit: uint32;
    transform: Ikkaku.Math.Transform; 
}

table BoneAnimation 
{
    tracks: [BoneTrack];
    initData: BoneInit;
}

table TRANM 
{
    info: AnimationInfo;
    track: BoneAnimation;
}

root_type TRANM;