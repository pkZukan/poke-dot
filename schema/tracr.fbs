namespace Titan.Animation;

table AnimResource 
{
    filename: string;
}

table AnimData
{
    //
}

table TrackResources 
{
    animation: AnimResource;
    material: AnimResource;
    effect: AnimResource;
}

table Track 
{
    track_name: string;
    res_0: string; //Never used
    res_1: uint32; //Never used
    track_resource: TrackResources;
}

table TrackList 
{
    list: [Track];
}
table TRACR 
{
    track_list: TrackList;
}

root_type TRACR;